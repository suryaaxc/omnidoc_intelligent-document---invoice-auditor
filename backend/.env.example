# Toggle offline realistic Azure AI-900 mock responses when API keys are omitted
DEMO_MODE=true

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Azure AI Document Intelligence (prebuilt-invoice & prebuilt-read)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_document_intelligence_key

# Azure AI Language (PII Recognition, NER & Summarization)
AZURE_LANGUAGE_ENDPOINT=https://your-language.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=your_language_key

# Azure OpenAI / Azure AI Foundry (Grounded Audit Q&A)
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
